{
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "atlassian@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "oh-my-claudecode@omc": true,
    "context-mode@context-mode": true,
    "typescript-lsp@claude-plugins-official": true
  },

  "permissions": {
    "deny": [
      "Bash(gh workflow run:*)",

      "Bash(pnpm exec infra-kit release-deliver:*)",
      "Bash(pnpm exec infra-kit release deliver:*)",
      "Bash(pnpm exec ik release-deliver:*)",
      "Bash(pnpm run dx-release-deliver:*)",
      "Bash(pnpm dx-release-deliver:*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-deploy.sh"
          }
        ]
      }
    ]
  }
}
