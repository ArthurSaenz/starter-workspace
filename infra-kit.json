{
  "envManagement": {
    "provider": "doppler",
    "config": {
      "name": "infra-kit"
    }
  },
  "vendorSource": {
    "copy": [
      { "path": ".claude" },
      { "path": ".cursor/mcp.json" },
      { "path": ".mcp.json" },
      { "path": ".cursor/rules" },
      { "path": "vendor/packages/web-toolkit", "module": "web-toolkit" },
      { "path": ".prettierrc.mjs" },
      { "path": ".prettierignore" },
      { "path": ".node-version" },
      { "path": ".gitignore" },
      { "path": ".editorconfig" },
      { "path": "vitest.config.ts" },
      { "path": "skills-lock.json" },
      { "path": ".agents" },
      { "path": "turbo.json" },
      { "path": "vendor/configs" },
      { "path": "vendor/packages/docs-ui" },
      { "path": "vendor/packages/auth-be", "module": "auth" },
      { "path": "vendor/packages/auth-fe", "module": "auth" },
      { "path": "vendor/packages/auth-emails", "module": "auth" },
      { "path": "vendor/packages/data-table", "module": "data-table" },
      { "path": "vendor/packages/site-index", "module": "site-index" },
      { "path": "devops/scripts/lib", "module": "devops-scripts" },
      { "path": ".github/workflows/_cache-nodemodules-jobs.yml" },
      { "path": ".github/workflows/_deploy-media-jobs.yml", "module": "deploy-media" },
      { "path": ".github/workflows/_notify-success-jobs.yml" },
      { "path": ".github/workflows/_terraform-apply-infrastructure-jobs.yml", "module": "terraform" }
    ],
    "exclude": ["serverless-config"]
  },
  "audit": {
    "requiredScripts": [],
    "requiredFiles": []
  }
}
