  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {}
  },
  "include": [
    "src",
    "typings"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/__stories__/**",
    "src/__spike__/**"
  ]
}
